    "pino": "^10.3.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}

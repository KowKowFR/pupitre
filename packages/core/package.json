{
  "name": "@pupitre/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schedule": {
      "types": "./dist/schedule.d.ts",
      "default": "./dist/schedule.js"
    },
    "./capture": {
      "types": "./dist/capture/index.d.ts",
      "default": "./dist/capture/index.js"
    },
    "./probe": {
      "types": "./dist/probe/index.d.ts",
      "default": "./dist/probe/index.js"
    },
    "./images": {
      "types": "./dist/images/index.d.ts",
      "default": "./dist/images/index.js"
    },
    "./ssh": {
      "types": "./dist/ssh/index.d.ts",
      "default": "./dist/ssh/index.js"
    },
    "./drivers": {
      "types": "./dist/drivers/index.d.ts",
      "default": "./dist/drivers/index.js"
    },
    "./scanners": {
      "types": "./dist/scanners/index.d.ts",
      "default": "./dist/scanners/index.js"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "default": "./dist/notifications/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js"
    },
    "./sources": {
      "types": "./dist/sources/index.d.ts",
      "default": "./dist/sources/index.js"
    },
    "./compose": {
      "types": "./dist/compose/index.d.ts",
      "default": "./dist/compose/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run copy-assets",
    "dev": "pnpm run copy-assets && tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "harness:probes": "tsx test/harness-probes.ts",
    "copy-assets": "mkdir -p dist/ai/prompts dist/spec/__fixtures__ && cp src/ai/prompts/*.md dist/ai/prompts/ && cp src/spec/__fixtures__/*.json dist/spec/__fixtures__/"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.52",
    "@ai-sdk/openai": "4.0.65",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "ai": "7.0.97",
    "node-ssh": "^13.2.1",
    "nodemailer": "^10.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/ssh2": "^1.15.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}

# Relais de test : se présente sous les noms de Let's Encrypt et relaie vers
# Pebble. Pour un proxy qui n'accepte d'autre autorité que Let's Encrypt
# (BunkerWeb), `pnpm test:proxy --proxy bunkerweb` fait pointer ces noms ici,
# dans le conteneur de test seulement, et lui fait reconnaître l'autorité
# interne de Caddy. Rien de cela n'existe hors de l'environnement de test.
{
	local_certs
	skip_install_trust
}

acme-staging-v02.api.letsencrypt.org, acme-v02.api.letsencrypt.org {
	tls internal
	# Pebble sert son annuaire sur /dir ; Let's Encrypt, sur /directory.
	rewrite /directory /dir
	reverse_proxy https://pebble:14000 {
		# Pebble bâtit ses URL avec l'hôte demandé : elles repassent par ici.
		header_up Host {host}
		transport http {
			tls_insecure_skip_verify
		}
	}
}

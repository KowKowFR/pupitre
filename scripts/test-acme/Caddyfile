# Test relay: it presents itself under Let's Encrypt's names and relays to
# Pebble. For a proxy that accepts no other authority than Let's Encrypt
# (BunkerWeb), `pnpm test:proxy --proxy bunkerweb` points these names here, in the
# test container only, and makes it recognize Caddy's internal authority. None
# of this exists outside the test environment.
{
	local_certs
	skip_install_trust
}

acme-staging-v02.api.letsencrypt.org, acme-v02.api.letsencrypt.org {
	tls internal
	# Pebble serves its directory on /dir; Let's Encrypt, on /directory.
	rewrite /directory /dir
	reverse_proxy https://pebble:14000 {
		# Pebble builds its URLs with the requested host: they come back through here.
		header_up Host {host}
		transport http {
			tls_insecure_skip_verify
		}
	}
}
